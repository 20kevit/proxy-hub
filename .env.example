# ProxyHub environment template — copy to /etc/proxy-hub/proxy-hub.env and fill in.
# NEVER commit the real file. NEVER put secrets in Git.

# Private subscription URL (kept secret, masked in UI/API/logs)
PROXYHUB_SUBSCRIPTION_URL=

# Admin login for the web panel (set a strong password)
PROXYHUB_ADMIN_USER=admin
PROXYHUB_ADMIN_PASSWORD=

# Signed automatically on first start if empty (keep secret, 32+ random chars)
PROXYHUB_SECRET_KEY=

# Local bind for the management API (keep on localhost; expose via Nginx if needed)
PROXYHUB_HOST=127.0.0.1
PROXYHUB_PORT=8899

# Paths (defaults are fine on Ubuntu)
PROXYHUB_DATA_DIR=/var/lib/proxy-hub
PROXYHUB_DB_PATH=/var/lib/proxy-hub/proxyhub.db

# Managed Xray core (separate from the pre-existing system Xray service)
PROXYHUB_XRAY_BIN=/usr/local/bin/xray
PROXYHUB_XRAY_CONFIG=/var/lib/proxy-hub/generated/xray.json
PROXYHUB_SOCKS_PORT=2081
PROXYHUB_HTTP_PORT=1081

# Optional managed sing-box core (only needed for Hysteria2 nodes)
PROXYHUB_SINGBOX_BIN=/usr/local/bin/sing-box
PROXYHUB_SINGBOX_CONFIG=/var/lib/proxy-hub/generated/sing-box.json
PROXYHUB_SINGBOX_ENABLED=false

# Schedulers (seconds)
PROXYHUB_SUB_UPDATE_INTERVAL=21600
PROXYHUB_HEALTH_INTERVAL=300

# Health check egress test endpoint (lightweight, configurable)
PROXYHUB_HEALTH_URL=https://api.ipify.org
PROXYHUB_HEALTH_TIMEOUT=15

# Failover policy
PROXYHUB_FAILOVER_MODE=auto
PROXYHUB_FAILOVER_THRESHOLD=3
PROXYHUB_FAILOVER_COOLDOWN=600

# Public client gateway (Xray inbounds inside the managed instance)
PROXYHUB_GATEWAY_ENABLED=false
PROXYHUB_GATEWAY_BIND=127.0.0.1
PROXYHUB_PUBLIC_SOCKS_PORT=8388
PROXYHUB_PUBLIC_HTTP_PORT=8389
PROXYHUB_DEFAULT_ROUTE=proxy
